{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Clusters": {
      "account-cluster": {
        "Destinations": {
          "main": {
            "Address": "http://accounts:8080/"
          }
        }
      },
      "game-cluster": {
        "Destinations": {
          "main": {
            "Address": "http://game:8080/"
          }
        }
      }
    },
    "Routes": {
      "accounts-route": {
        "ClusterId": "account-cluster",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        }
      },
      "game-route": {
        "ClusterId": "game-cluster",
        "Match": {
          "Path": "/api/game/{**catch-all}"
        }
      },
      "game-hub-route": {
        "ClusterId": "game-cluster",
        "Match": {
          "Path": "/hubs/game/{**catch-all}"
        }
      }
    }
  }
}
